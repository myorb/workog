---
import { getLang, localizePath } from "../lib/i18n.ts";

interface Props {
  links: { href: string; label: string; count: number }[];
}

const { links } = Astro.props;
const lang = getLang(Astro.params.lang);
---

<ul class="tag-links">
  {
    links.map((l) => (
      <li>
        <a href={localizePath(l.href, lang)}>{l.label}</a> <span class="muted">{l.count}</span>
      </li>
    ))
  }
</ul>

<style>
  .tag-links { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 8px 16px; }
  @media (max-width: 640px) {
    .tag-links { grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 0 16px; }
    .tag-links li { padding: 8px 0; line-height: 1.4; }
    .tag-links a { padding: 8px 0; }
  }
</style>
