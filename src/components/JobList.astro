---
import type { Job } from "../lib/schema.ts";
import { getCompanies, tagsOf } from "../lib/jobs.ts";
import { isMedicine } from "../lib/medicine.ts";
import { formatDate, formatLocations } from "../lib/format.ts";
import { getLang, t } from "../lib/i18n.ts";

interface Props {
  jobs: Job[];
  showCompany?: boolean;
}

const { jobs, showCompany = true } = Astro.props;
const lang = getLang(Astro.params.lang);
const m = t(lang);
const companyNames = new Map((await getCompanies()).map((c) => [c.key, c.name]));
---

<ul class="job-list">
  {
    jobs.map((job) => (
      <li>
        <a class="title" href={`/jobs/${job.slug}`}>{job.title}</a>
        <div class="meta">
          {/* a job board's jobs name their employer even on the board's own page */}
          {(showCompany || job.employer) && <span class="company">{job.employer ?? companyNames.get(job.company) ?? job.company}</span>}
          {/* every doctor job comes from the same few boards, so naming the board adds nothing */}
          {showCompany && job.employer && !isMedicine(job) && <span>{m.via(companyNames.get(job.company) ?? job.company)}</span>}
          <span>{formatLocations(job.locations, job.remote, 3, lang)}</span>
          {job.specialty && <span class="tag">{m.medicine.specialties[job.specialty]}</span>}
          {job.remote && <span class="tag">{m.remote}</span>}
          {[...tagsOf(job).employment].filter((e) => e !== "full-time").map((e) => <span class="tag">{m.employment.types[e]}</span>)}
          <span class="muted">{m.seen(formatDate(job.firstSeenAt, lang))}</span>
        </div>
      </li>
    ))
  }
</ul>

<style>
  .job-list { list-style: none; padding: 0; margin: 0; border-top: 1px solid var(--border); }
  li { padding: 12px 0; border-bottom: 1px solid var(--border); }
  .title { font-weight: 600; text-decoration: none; }
  .title:hover { text-decoration: underline; }
  .meta { display: flex; flex-wrap: wrap; gap: 4px 12px; font-size: 14px; color: var(--muted); margin-top: 2px; }
  .company { color: var(--text); font-weight: 500; }
</style>
