---
import { getLatestRun } from "../lib/jobs.ts";
import { formatDateTime } from "../lib/format.ts";
import { getLang, languageNames, localizePath, locales, stripLang, t } from "../lib/i18n.ts";
import { intlLocale } from "../lib/locale.ts";

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  /** false for pages that exist in English only */
  translated?: boolean;
  /** schema.org objects, rendered as one JSON-LD script each */
  jsonLd?: Record<string, unknown>[];
}

const { title, description, noindex = false, translated = true, jsonLd = [] } = Astro.props;
const lang = translated ? getLang(Astro.params.lang) : "en";
const m = t(lang);
const u = (path: string) => localizePath(path, lang);
// build.format "file" renders pathnames as "/index.html" or "/uk.html"; links use the extensionless URL
const pathname = Astro.url.pathname.replace(/\.html$/, "").replace(/\/index$/, "") || "/";
const canonical = new URL(pathname, Astro.site);
const basePath = stripLang(pathname);
const alternates = translated ? locales.map((l) => ({ lang: l, href: new URL(localizePath(basePath, l), Astro.site) })) : [];
const run = await getLatestRun();
const fullTitle = title === "Workog" ? title : `${title} · Workog`;
const ogLocale = (l: string) => intlLocale(l as typeof lang).replace("-", "_");
const ogImage = new URL("/og.png", Astro.site);
// "</" inside JSON would close the script tag early
const ldJson = (data: Record<string, unknown>) => JSON.stringify({ "@context": "https://schema.org", ...data }).replace(/</g, "\\u003c");
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-CZBM19V93R"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      gtag("js", new Date());
      gtag("config", "G-CZBM19V93R");
    </script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large, max-snippet:-1"} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1c1917" media="(prefers-color-scheme: dark)" />
    <meta name="application-name" content="Workog" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Workog" />
    <meta property="og:locale" content={ogLocale(lang)} />
    {alternates.filter((a) => a.lang !== lang).map((a) => <meta property="og:locale:alternate" content={ogLocale(a.lang)} />)}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Workog — open jobs at top tech companies" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={a.href} />)}
    {alternates.length > 0 && <link rel="alternate" hreflang="x-default" href={alternates[0]!.href} />}
    {jsonLd.map((data) => <script type="application/ld+json" set:html={ldJson(data)} />)}
    <slot name="head" />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href={u("/")}>Workog</a>
        <nav>
          <a href={u("/remote")}>{m.nav.remote}</a>
          <a href={u("/locations")}>{m.nav.locations}</a>
          <a href={u("/technologies")}>{m.nav.technologies}</a>
          <a href={u("/companies")}>{m.nav.companies}</a>
          <a href={u("/analytics")}>{m.nav.analytics}</a>
        </nav>
        {
          translated && (
            <nav class="langs" aria-label={m.language}>
              {locales.map((l) => (
                <a href={localizePath(basePath, l)} hreflang={l} lang={l} title={languageNames[l]} aria-current={l === lang ? "page" : undefined}>
                  {l.toUpperCase()}
                </a>
              ))}
            </nav>
          )
        }
      </div>
    </header>
    <main class="wrap">
      <slot />
    </main>
    <footer class="wrap site-footer">
      {run && <p>{m.lastUpdated} <time datetime={run.finishedAt}>{formatDateTime(run.finishedAt, lang)}</time></p>}
      <p>{m.footerNote}</p>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --bg: #fafaf9;
    --surface: #ffffff;
    --text: #1c1917;
    --muted: #57534e;
    --border: #e7e5e4;
    --accent: #2563eb;
    --accent-text: #ffffff;
    --tag: #f5f5f4;
    color-scheme: light dark;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #0c0a09;
      --surface: #1c1917;
      --text: #f5f5f4;
      --muted: #a8a29e;
      --border: #292524;
      --accent: #60a5fa;
      --accent-text: #0c0a09;
      --tag: #292524;
    }
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font: 16px/1.6 system-ui, -apple-system, "Segoe UI", sans-serif;
  }
  a { color: var(--accent); }
  h1, h2, h3 { line-height: 1.25; }
  .wrap { max-width: 860px; margin: 0 auto; padding: 0 16px; }
  .site-header { border-bottom: 1px solid var(--border); background: var(--surface); }
  .site-header .wrap { display: flex; align-items: center; justify-content: space-between; height: 56px; }
  .site-header nav { display: flex; gap: 20px; }
  .site-header a { color: var(--text); text-decoration: none; }
  .brand { font-weight: 700; white-space: nowrap; }
  .site-header .langs { gap: 8px; font-size: 13px; }
  .site-header .langs a { color: var(--muted); }
  .site-header .langs a[aria-current] { color: var(--text); font-weight: 600; }
  @media (max-width: 480px) {
    .site-header .wrap { height: auto; flex-wrap: wrap; gap: 4px 12px; padding-top: 10px; padding-bottom: 10px; }
    .site-header nav { flex-wrap: wrap; gap: 0 12px; font-size: 14px; }
  }
  main { padding-top: 24px; padding-bottom: 48px; }
  .site-footer { border-top: 1px solid var(--border); color: var(--muted); font-size: 14px; padding-top: 16px; padding-bottom: 32px; }
  .site-footer p { margin: 4px 0; }
  .muted { color: var(--muted); }
  .tag { display: inline-block; background: var(--tag); border-radius: 4px; padding: 0 8px; font-size: 13px; }
</style>
