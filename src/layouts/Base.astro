---
import { getLatestRun } from "../lib/jobs.ts";
import { formatDateTime } from "../lib/format.ts";

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const run = await getLatestRun();
const fullTitle = title === "Static Job" ? title : `${title} · Static Job`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <slot name="head" />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href="/">Static Job</a>
        <nav>
          <a href="/locations">Locations</a>
          <a href="/technologies">Technologies</a>
          <a href="/companies">Companies</a>
          <a href="/analytics">Analytics</a>
        </nav>
      </div>
    </header>
    <main class="wrap">
      <slot />
    </main>
    <footer class="wrap site-footer">
      {run && <p>Last updated <time datetime={run.finishedAt}>{formatDateTime(run.finishedAt)}</time></p>}
      <p>Listings link to each company's official posting. Apply on the company's site.</p>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --bg: #fafaf9;
    --surface: #ffffff;
    --text: #1c1917;
    --muted: #57534e;
    --border: #e7e5e4;
    --accent: #2563eb;
    --accent-text: #ffffff;
    --tag: #f5f5f4;
    color-scheme: light dark;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #0c0a09;
      --surface: #1c1917;
      --text: #f5f5f4;
      --muted: #a8a29e;
      --border: #292524;
      --accent: #60a5fa;
      --accent-text: #0c0a09;
      --tag: #292524;
    }
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font: 16px/1.6 system-ui, -apple-system, "Segoe UI", sans-serif;
  }
  a { color: var(--accent); }
  h1, h2, h3 { line-height: 1.25; }
  .wrap { max-width: 860px; margin: 0 auto; padding: 0 16px; }
  .site-header { border-bottom: 1px solid var(--border); background: var(--surface); }
  .site-header .wrap { display: flex; align-items: center; justify-content: space-between; height: 56px; }
  .site-header nav { display: flex; gap: 20px; }
  .site-header a { color: var(--text); text-decoration: none; }
  .brand { font-weight: 700; white-space: nowrap; }
  @media (max-width: 480px) {
    .site-header .wrap { height: auto; flex-wrap: wrap; gap: 4px 12px; padding-top: 10px; padding-bottom: 10px; }
    .site-header nav { gap: 12px; font-size: 14px; }
  }
  main { padding-top: 24px; padding-bottom: 48px; }
  .site-footer { border-top: 1px solid var(--border); color: var(--muted); font-size: 14px; padding-top: 16px; padding-bottom: 32px; }
  .site-footer p { margin: 4px 0; }
  .muted { color: var(--muted); }
  .tag { display: inline-block; background: var(--tag); border-radius: 4px; padding: 0 8px; font-size: 13px; }
</style>
