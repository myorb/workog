---
import { getLatestRun, getMedicineSnapshots } from "../lib/jobs.ts";
import { reportsUrl, reportUrl } from "../lib/reports.ts";
import { formatDateTime } from "../lib/format.ts";
import { getLang, languageNames, localizePath, locales, stripLang, t } from "../lib/i18n.ts";
import { intlLocale } from "../lib/locale.ts";
import Logo from "../components/Logo.astro";
import { faviconPaths } from "../lib/logo.ts";

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  /** false for pages that exist in English only */
  translated?: boolean;
  /** schema.org objects, rendered as one JSON-LD script each */
  jsonLd?: Record<string, unknown>[];
  /** which section's header to show; the start page has the top bar only */
  section?: "tech" | "medicine" | "start";
}

const { title, description, noindex = false, translated = true, jsonLd = [], section = "tech" } = Astro.props;
const lang = translated ? getLang(Astro.params.lang) : "en";
const m = t(lang);
const u = (path: string) => localizePath(path, lang);
// build.format "file" renders pathnames as "/index.html" or "/uk.html"; links use the extensionless URL
const pathname = Astro.url.pathname.replace(/\.html$/, "").replace(/\/index$/, "") || "/";
const canonical = new URL(pathname, Astro.site);
const basePath = stripLang(pathname);
const alternates = translated ? locales.map((l) => ({ lang: l, href: new URL(localizePath(basePath, l), Astro.site) })) : [];
const run = await getLatestRun();
const medicineMonth = (await getMedicineSnapshots()).at(-1)?.date.slice(0, 7);
const fullTitle = title === "Workog" ? title : `${title} · Workog`;
const ogLocale = (l: string) => intlLocale(l as typeof lang).replace("-", "_");
// one share image per section; its alt text repeats the image's own (English) text
const shareImages = {
  tech: { path: "/og-tech.png", alt: "Workog — top tech jobs, every company that matters" },
  medicine: { path: "/og-medicine.png", alt: "Workog — top doctor jobs, every hospital that matters" },
  start: { path: "/og.png", alt: "Workog — top tech jobs, top doctor jobs" },
};
const shareImage = shareImages[section];
// the favicon takes the section's color, like the logo in the top bar
const favicon = faviconPaths(section);
const ogImage = new URL(shareImage.path, Astro.site);
// "</" inside JSON would close the script tag early
const ldJson = (data: Record<string, unknown>) => JSON.stringify({ "@context": "https://schema.org", ...data }).replace(/</g, "\\u003c");
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-CZBM19V93R"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      gtag("js", new Date());
      gtag("config", "G-CZBM19V93R");
    </script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large, max-snippet:-1"} />
    <link rel="icon" href={favicon.ico} sizes="32x32" />
    <link rel="icon" href={favicon.svg} type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1c1917" media="(prefers-color-scheme: dark)" />
    <meta name="application-name" content="Workog" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Workog" />
    <meta property="og:locale" content={ogLocale(lang)} />
    {alternates.filter((a) => a.lang !== lang).map((a) => <meta property="og:locale:alternate" content={ogLocale(a.lang)} />)}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={shareImage.alt} />
    <meta name="twitter:image:alt" content={shareImage.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={a.href} />)}
    {alternates.length > 0 && <link rel="alternate" hreflang="x-default" href={alternates[0]!.href} />}
    {jsonLd.map((data) => <script type="application/ld+json" set:html={ldJson(data)} />)}
    <slot name="head" />
  </head>
  <body>
    <div class={`top-bar ${section}`}>
      <div class="wrap">
        <nav aria-label={m.sections.label}>
          <a class="brand" href={u("/")}><Logo size={22} variant={section} />Workog</a>
          <a class="tab" href={u("/tech")} aria-current={section === "tech" ? "true" : undefined}>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 7l-5 5 5 5M16 7l5 5-5 5" /></svg>
            <span class="long">{m.sections.tech}</span><span class="short">{m.sections.techShort}</span>
          </a>
          <a class="tab" href={u("/medicine")} aria-current={section === "medicine" ? "true" : undefined}>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
            <span class="long">{m.sections.medicine}</span><span class="short">{m.sections.medicineShort}</span>
          </a>
        </nav>
        {
          translated && (
            <details class="langs">
              <summary aria-label={m.language} title={languageNames[lang]}>{lang.toUpperCase()}</summary>
              <div class="lang-menu" role="list">
                {locales.map((l) => (
                  <a role="listitem" href={localizePath(basePath, l)} hreflang={l} lang={l} aria-current={l === lang ? "page" : undefined}>
                    <span>{l.toUpperCase()}</span> {languageNames[l]}
                  </a>
                ))}
              </div>
            </details>
            <script is:inline>
              // close the language menu on outside click or Escape
              document.addEventListener("click", (e) => {
                const d = document.querySelector(".top-bar .langs");
                if (d && d.open && !d.contains(e.target)) d.open = false;
              });
              document.addEventListener("keydown", (e) => {
                const d = document.querySelector(".top-bar .langs");
                if (e.key === "Escape" && d && d.open) { d.open = false; d.querySelector("summary").focus(); }
              });
            </script>
          )
        }
      </div>
    </div>
    {
      section !== "start" && (
        <header class={`site-header ${section}`}>
          <div class="wrap">
            {section === "medicine" ? (
              <>
                <a class="section-brand" href={u("/medicine")}>
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
                  {m.sections.medicine}
                </a>
                <nav>
                  <a href={u("/medicine/specialties")}>{m.medicine.nav.specialties}</a>
                  <a href={u("/medicine/locations")}>{m.medicine.nav.locations}</a>
                  <a href={u("/medicine/levels")}>{m.medicine.nav.levels}</a>
                  <a href={u("/medicine/hospitals")}>{m.medicine.nav.hospitals}</a>
                  {medicineMonth && <a href={u(reportUrl("medicine", medicineMonth))}>{m.reports.nav}</a>}
                </nav>
              </>
            ) : (
              <>
                <a class="section-brand" href={u("/tech")}>
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 7l-5 5 5 5M16 7l5 5-5 5" /></svg>
                  {m.sections.tech}
                </a>
                <nav>
                  <a href={u("/remote")}>{m.nav.remote}</a>
                  <a href={u("/locations")}>{m.nav.locations}</a>
                  <a href={u("/technologies")}>{m.nav.technologies}</a>
                  <a href={u("/companies")}>{m.nav.companies}</a>
                  <a href={u("/analytics")}>{m.nav.analytics}</a>
                </nav>
              </>
            )}
          </div>
        </header>
      )
    }
    <main class={`wrap ${section === "start" ? "start" : ""}`}>
      <slot />
    </main>
    <footer class="wrap site-footer">
      {run && <p>{m.lastUpdated} <time datetime={run.finishedAt}>{formatDateTime(run.finishedAt, lang)}</time></p>}
      <p>{m.footerNote}</p>
      <p><a href={u(reportsUrl)}>{m.reports.title}</a> · <a href="/llms.txt">llms.txt</a></p>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --bg: #fafaf9;
    --surface: #ffffff;
    --text: #1c1917;
    --muted: #57534e;
    --border: #e7e5e4;
    --accent: #2563eb;
    --visited: #7c3aed;
    --accent-text: #ffffff;
    --tag: #f5f5f4;
    color-scheme: light dark;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #0c0a09;
      --surface: #1c1917;
      --text: #f5f5f4;
      --muted: #a8a29e;
      --border: #292524;
      --accent: #60a5fa;
      --visited: #c084fc;
      --accent-text: #0c0a09;
      --tag: #292524;
    }
  }
  * { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; text-size-adjust: 100%; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font: 16px/1.6 system-ui, -apple-system, "Segoe UI", sans-serif;
  }
  a { color: var(--accent); }
  h1, h2, h3 { line-height: 1.25; overflow-wrap: break-word; }
  h1 { font-size: clamp(1.6rem, 6vw, 2rem); }
  h2 { font-size: clamp(1.3rem, 4.5vw, 1.5rem); }
  .wrap { max-width: 1200px; margin: 0 auto; padding: 0 24px; }
  @media (max-width: 640px) { .wrap { padding: 0 16px; } }

  /* Top bar: which part of Workog you are in. Section colors live only here and in the header below */
  .top-bar { background: #141a19; border-bottom: 1px solid #2a3331; color: #f5f5f4; font-size: 14px; }
  .top-bar.tech { background: #070d19; border-color: #22345a; }
  .top-bar.medicine { background: #061412; border-color: #1d4640; }
  .top-bar .wrap { display: flex; align-items: stretch; justify-content: space-between; gap: 12px; min-height: 44px; }
  .top-bar nav { display: flex; align-items: stretch; gap: 4px; }
  .top-bar a { color: inherit; text-decoration: none; }
  .brand { display: flex; align-items: center; gap: 8px; padding-right: 10px; font-weight: 700; white-space: nowrap; }
  .brand svg { flex: none; }
  .tab { display: flex; align-items: center; gap: 6px; padding: 0 12px; color: #a8b0ae; border-bottom: 2px solid transparent; white-space: nowrap; }
  .top-bar .tab { color: #a8b0ae; }
  .top-bar .tab:hover { color: #f5f5f4; }
  .top-bar.tech .tab[aria-current] { color: #f5f5f4; font-weight: 600; border-bottom-color: #60a5fa; }
  .top-bar.tech .tab[aria-current] svg { color: #60a5fa; }
  .top-bar.medicine .tab[aria-current] { color: #f5f5f4; font-weight: 600; border-bottom-color: #2dd4bf; }
  .top-bar.medicine .tab[aria-current] svg { color: #2dd4bf; }
  .tab .short { display: none; }
  @media (max-width: 640px) {
    .tab { padding: 0 9px; }
    .tab .long { display: none; }
    .tab .short { display: inline; }
  }

  .site-header { background: #13233f; border-bottom: 1px solid #22345a; color: #f5f5f4; }
  .site-header.medicine { background: #0f2e2a; border-color: #1d4640; }
  .site-header .wrap { display: flex; align-items: center; justify-content: space-between; gap: 16px; min-height: 56px; }
  .site-header nav { display: flex; gap: 20px; }
  .site-header a { color: #e7ecf3; text-decoration: none; }
  .site-header a:hover { color: #ffffff; }
  .section-brand { display: flex; align-items: center; gap: 8px; font-weight: 700; white-space: nowrap; }
  .site-header.tech .section-brand svg { color: #60a5fa; }
  .site-header.medicine .section-brand svg { color: #2dd4bf; }

  .langs { position: relative; align-self: center; font-size: 13px; }
  .langs summary {
    display: flex; align-items: center; gap: 4px; padding: 4px 8px; border: 1px solid rgb(255 255 255 / 0.18);
    border-radius: 6px; cursor: pointer; font-weight: 600; list-style: none; user-select: none;
  }
  .langs summary::-webkit-details-marker { display: none; }
  .langs summary::after {
    content: ""; width: 6px; height: 6px; margin: -3px 2px 0 2px;
    border-right: 1.5px solid #a8b0ae; border-bottom: 1.5px solid #a8b0ae; transform: rotate(45deg);
  }
  .langs[open] summary::after { margin-top: 3px; transform: rotate(-135deg); }
  .lang-menu {
    position: absolute; right: 0; top: calc(100% + 6px); z-index: 10; min-width: 150px; padding: 4px;
    background: var(--surface); border: 1px solid var(--border); border-radius: 8px; box-shadow: 0 6px 20px rgb(0 0 0 / 0.12);
  }
  .top-bar .lang-menu a { display: flex; gap: 10px; padding: 6px 10px; border-radius: 4px; font-size: 14px; color: var(--text); }
  .lang-menu a span { width: 22px; color: var(--muted); font-size: 12px; font-weight: 600; line-height: 21px; }
  .lang-menu a:hover { background: var(--tag); }
  .lang-menu a[aria-current] { font-weight: 600; }
  @media (max-width: 640px) {
    /* section name on the first row, its nav as one swipeable row of pills below */
    .site-header .wrap { flex-wrap: wrap; gap: 8px; padding-top: 10px; padding-bottom: 10px; }
    .section-brand { font-size: 18px; }
    .site-header nav {
      flex: 1 0 100%; gap: 6px; margin: 0 -16px; padding: 0 16px;
      overflow-x: auto; scrollbar-width: none; white-space: nowrap; font-size: 15px;
    }
    .site-header nav::-webkit-scrollbar { display: none; }
    .site-header nav a { padding: 7px 14px; border-radius: 999px; background: rgb(255 255 255 / 0.1); }
    .lang-menu a { padding: 10px 12px; }
  }
  main { padding-top: 24px; padding-bottom: 48px; }
  /* the start page's two panels run edge to edge */
  main.start { max-width: none; padding: 0; }
  @media (max-width: 640px) {
    main { padding-top: 16px; }
  }
  .site-footer { border-top: 1px solid var(--border); color: var(--muted); font-size: 14px; padding-top: 16px; padding-bottom: 32px; }
  .site-footer p { margin: 4px 0; }
  .muted { color: var(--muted); }
  .tag { display: inline-block; background: var(--tag); border-radius: 4px; padding: 0 8px; font-size: 13px; }
</style>
