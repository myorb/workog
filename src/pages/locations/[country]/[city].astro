---
import type { GetStaticPaths } from "astro";
import Base from "../../../layouts/Base.astro";
import JobList from "../../../components/JobList.astro";
import TagLinks from "../../../components/TagLinks.astro";
import { countTags, getJobsWhere } from "../../../lib/jobs.ts";
import { cities, getCountry } from "../../../lib/places.ts";
import { countryUrl, technologyLinks, technologyUrl } from "../../../lib/links.ts";
import { plural } from "../../../lib/format.ts";
import { LIST_PAGE_LIMIT } from "../../../lib/constants.ts";

export const getStaticPaths = (async () => {
  const counts = await countTags();
  return cities
    .filter((c) => counts.cities.has(c.slug))
    .map((city) => ({ params: { country: city.country, city: city.slug }, props: { city, country: getCountry(city.country)! } }));
}) satisfies GetStaticPaths;

const { city, country } = Astro.props;
const jobs = await getJobsWhere({ city: city.slug });
const counts = await countTags(jobs);
const techs = technologyLinks(counts.technologies, (t) => technologyUrl(t, country.slug, city.slug));
---

<Base title={`Jobs in ${city.name}, ${country.name}`} description={`${plural(jobs.length, "open tech job")} in ${city.name}, ${country.name}. Updated daily.`}>
  <p class="muted"><a href="/locations">Locations</a> / <a href={countryUrl(country.slug)}>{country.name}</a> /</p>
  <h1>Jobs in {city.name}</h1>
  <p class="muted">
    {plural(jobs.length, "open position")}
    {jobs.length > LIST_PAGE_LIMIT && <>, showing the {LIST_PAGE_LIMIT} newest</>}
  </p>
  {techs.length > 0 && <><h2>Technologies</h2><TagLinks links={techs} /></>}
  <h2>Latest jobs</h2>
  <JobList jobs={jobs.slice(0, LIST_PAGE_LIMIT)} />
</Base>
