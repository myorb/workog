---
import type { GetStaticPaths } from "astro";
import Base from "../../../layouts/Base.astro";
import JobList from "../../../components/JobList.astro";
import TagLinks from "../../../components/TagLinks.astro";
import { countTags, getJobsWhere } from "../../../lib/jobs.ts";
import { countries } from "../../../lib/places.ts";
import { cityLinks, technologyLinks, technologyUrl } from "../../../lib/links.ts";
import { plural } from "../../../lib/format.ts";
import { LIST_PAGE_LIMIT } from "../../../lib/constants.ts";

export const getStaticPaths = (async () => {
  const counts = await countTags();
  return countries.filter((c) => counts.countries.has(c.slug)).map((country) => ({ params: { country: country.slug }, props: { country } }));
}) satisfies GetStaticPaths;

const { country } = Astro.props;
const jobs = await getJobsWhere({ country: country.slug });
const counts = await countTags(jobs);
const cities = cityLinks(counts.cities, undefined, country.slug);
const techs = technologyLinks(counts.technologies, (t) => technologyUrl(t, country.slug));
---

<Base title={`Jobs in ${country.name}`} description={`${plural(jobs.length, "open tech job")} in ${country.name}, including remote roles. Updated daily.`}>
  <p class="muted"><a href="/locations">Locations</a> /</p>
  <h1>Jobs in {country.name}</h1>
  <p class="muted">
    {plural(jobs.length, "open position")}
    {jobs.length > LIST_PAGE_LIMIT && <>, showing the {LIST_PAGE_LIMIT} newest</>}
  </p>
  {cities.length > 0 && <><h2>Cities</h2><TagLinks links={cities} /></>}
  {techs.length > 0 && <><h2>Technologies</h2><TagLinks links={techs} /></>}
  <h2>Latest jobs</h2>
  <JobList jobs={jobs.slice(0, LIST_PAGE_LIMIT)} />
</Base>
