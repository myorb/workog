---
import type { GetStaticPaths } from "astro";
import Base from "../../../layouts/Base.astro";
import JobList from "../../../components/JobList.astro";
import TagLinks from "../../../components/TagLinks.astro";
import { countTags, getJobsWhere } from "../../../lib/jobs.ts";
import { technologies } from "../../../lib/technologies.ts";
import { cityLinks, countryLinks, technologyUrl } from "../../../lib/links.ts";
import { plural } from "../../../lib/format.ts";
import { LIST_PAGE_LIMIT } from "../../../lib/constants.ts";

export const getStaticPaths = (() => technologies.map((tech) => ({ params: { tech: tech.slug }, props: { tech } }))) satisfies GetStaticPaths;

const { tech } = Astro.props;
const jobs = await getJobsWhere({ technology: tech.slug });
const counts = await countTags(jobs);
const countries = countryLinks(counts.countries, (c) => technologyUrl(tech.slug, c));
const cities = cityLinks(counts.cities, (country, city) => technologyUrl(tech.slug, country, city)).slice(0, 24);
---

<Base
  title={`${tech.name} jobs`}
  description={`${plural(jobs.length, `open ${tech.name} job`)} at top tech companies, in ${countries.length} countries. Updated daily.`}
  noindex={!jobs.length}
>
  <p class="muted"><a href="/technologies">Technologies</a> /</p>
  <h1>{tech.name} jobs</h1>
  <p class="muted">
    {plural(jobs.length, "open position")}
    {jobs.length > LIST_PAGE_LIMIT && <>, showing the {LIST_PAGE_LIMIT} newest</>}
  </p>
  {countries.length > 0 && <><h2>By country</h2><TagLinks links={countries} /></>}
  {cities.length > 0 && <><h2>Top cities</h2><TagLinks links={cities} /></>}
  <h2>Latest jobs</h2>
  {jobs.length ? <JobList jobs={jobs.slice(0, LIST_PAGE_LIMIT)} /> : <p>No open {tech.name} positions right now.</p>}
</Base>
