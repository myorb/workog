---
import type { GetStaticPaths } from "astro";
import Base from "../../layouts/Base.astro";
import JobList from "../../components/JobList.astro";
import TagLinks from "../../components/TagLinks.astro";
import { getAllJobs, getCompany, getCompanyCounts, getRemoteCount, getTagCounts, tagsOf } from "../../lib/jobs.ts";
import { relatedJobs } from "../../lib/related.ts";
import { cityLinks, countryLinks, employmentLinks, remoteUrl, technologyLinks } from "../../lib/links.ts";
import { getCity, getCountry } from "../../lib/places.ts";
import { formatDate, formatLocations } from "../../lib/format.ts";
import { breadcrumbs, jobPosting } from "../../lib/structured-data.ts";
import { employmentTypeOf } from "../../lib/employment.ts";
import { categoryName, t } from "../../lib/i18n.ts";
import { formatNumber } from "../../lib/locale.ts";

export const getStaticPaths = (async () => {
  const jobs = await getAllJobs();
  return jobs.map((job) => ({ params: { slug: job.slug }, props: { job } }));
}) satisfies GetStaticPaths;

const { job } = Astro.props;
const company = await getCompany(job.company);
const companyName = company?.name ?? job.company;
const closed = Boolean(job.closedAt);
const where = formatLocations(job.locations, job.remote, 2);
const employment = employmentTypeOf(job);
const url = new URL(`/jobs/${job.slug}`, Astro.site);
// closed jobs are noindexed, so they drop the posting markup too
const jsonLd = [
  breadcrumbs([
    { name: "Companies", url: new URL("/companies", Astro.site) },
    { name: companyName, url: new URL(`/companies/${job.company}`, Astro.site) },
    { name: job.title, url },
  ]),
  ...(closed ? [] : [jobPosting(job, companyName, url)]),
];

// Crosslinks: neighbouring jobs, so every job is linked from other job pages, and the hubs this job belongs to
const related = await relatedJobs(job);
const companyJobs = (await getCompanyCounts()).get(job.company) ?? 0;
const tags = tagsOf(job);
const [city] = tags.cities;
const [country] = tags.countries;
const placeName = city ? getCity(city)?.name : country ? getCountry(country)?.name : "remote";
const counts = await getTagCounts();
const only = (slugs: Set<string>, all: Map<string, number>) => new Map([...all].filter(([slug]) => slugs.has(slug)));
const browse = [
  ...technologyLinks(only(tags.technologies, counts.technologies)),
  ...cityLinks(only(tags.cities, counts.cities)),
  ...countryLinks(only(tags.countries, counts.countries)),
  ...(job.remote ? [{ href: remoteUrl(), label: "Remote", count: await getRemoteCount() }] : []),
  ...employmentLinks(only(tags.employment, counts.employment)),
];
---

<Base
  title={`${job.title} at ${companyName}`}
  description={`${job.title} at ${companyName} — ${where}${job.remote ? " (remote)" : ""}. Apply on ${companyName}'s official careers site.`}
  noindex={closed}
  translated={false}
  jsonLd={jsonLd}
>
  <p class="muted"><a href={`/companies/${job.company}`}>{companyName}</a> /</p>

  {closed && <p class="closed">This position was closed on {formatDate(job.closedAt!)} and is no longer accepting applications.</p>}

  <h1>{job.title}</h1>
  <dl class="facts">
    <dt>Company</dt><dd><a href={`/companies/${job.company}`}>{companyName}</a></dd>
    <dt>Location</dt><dd>{job.locations.join(" · ") || "Not listed"}{job.remote && <> <a class="tag" href="/remote">Remote</a></>}</dd>
    <dt>Employment type</dt><dd><a href={`/employment/${employment}`}>{t("en").employment.types[employment]}</a></dd>
    {job.department && <><dt>Team</dt><dd>{job.department}</dd></>}
    {job.postedAt && <><dt>Posted</dt><dd>{formatDate(job.postedAt)}</dd></>}
  </dl>

  {!closed && <p><a class="apply" href={job.applyUrl} rel="nofollow noopener" target="_blank">Apply on {companyName}'s site →</a></p>}

  <article class="description" set:html={job.descriptionHtml} />

  {!closed && <p><a class="apply" href={job.applyUrl} rel="nofollow noopener" target="_blank">Apply on {companyName}'s site →</a></p>}

  {
    related.team.length > 0 && (
      <section>
        <h2>More {job.category ? `${categoryName(job.category, "en")} jobs` : "jobs"} at {companyName}</h2>
        <JobList jobs={related.team} showCompany={false} />
        {companyJobs > related.team.length + 1 && <p><a href={`/companies/${job.company}`}>All {formatNumber(companyJobs)} jobs at {companyName} →</a></p>}
      </section>
    )
  }
  {
    related.place.length > 0 && (
      <section>
        <h2>{placeName === "remote" ? "More remote jobs" : `More jobs in ${placeName}`}</h2>
        <JobList jobs={related.place} />
      </section>
    )
  }
  {browse.length > 0 && <section><h2>Browse similar jobs</h2><TagLinks links={browse} /></section>}
</Base>

<style>
  .facts { display: grid; grid-template-columns: max-content 1fr; gap: 4px 16px; margin: 16px 0 24px; }
  .facts dt { color: var(--muted); }
  .facts dd { margin: 0; }
  .apply { display: inline-block; background: var(--accent); color: var(--accent-text); padding: 10px 18px; border-radius: 6px; font-weight: 600; text-decoration: none; }
  .closed { background: var(--tag); border-left: 4px solid var(--muted); padding: 12px 16px; }
  .description { margin: 24px 0; overflow-wrap: anywhere; }
  .description :global(table) { display: block; overflow-x: auto; }
</style>
