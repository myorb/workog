---
import type { GetStaticPaths } from "astro";
import type { Job } from "../../lib/schema.ts";
import Base from "../../layouts/Base.astro";
import JobList from "../../components/JobList.astro";
import TagLinks from "../../components/TagLinks.astro";
import { getAllJobs, getCompany, getCompanyCounts, getHospitalIndex, getLatestRun, getMedicineCounts, getMedicineJobsWhere, getRemoteCount, getSnapshots, getTagCounts, medicinePlace, tagsOf } from "../../lib/jobs.ts";
import { jobSummary } from "../../lib/job-summary.ts";
import { getTechnology } from "../../lib/technologies.ts";
import { changeOver } from "../../lib/trend.ts";
import { hospitalSlugOf, hospitalUrl } from "../../lib/hospitals.ts";
import { areaFilter, areaName, GERMANY, getArea, isMedicine, levelUrl, medicineLocationUrl, MIN_CITY_JOBS, specialtyUrl } from "../../lib/medicine.ts";
import { relatedJobs } from "../../lib/related.ts";
import { cityLinks, countryLinks, employmentLinks, remoteUrl, technologyLinks } from "../../lib/links.ts";
import { getCity, getCountry } from "../../lib/places.ts";
import { formatDate, formatLocations, formatSalary } from "../../lib/format.ts";
import { breadcrumbs, jobPosting } from "../../lib/structured-data.ts";
import { employmentTypeOf } from "../../lib/employment.ts";
import { categoryName, countryName, localizePath, locales, t, type Lang } from "../../lib/i18n.ts";
import { jobLanguage } from "../../lib/language.ts";

export const getStaticPaths = (async () => {
  const jobs = await getAllJobs();
  return jobs.map((job) => ({ params: { slug: job.slug }, props: { job } }));
}) satisfies GetStaticPaths;

const { job } = Astro.props;
// The page speaks the posting's language when the site has it (German and Spanish postings), English otherwise;
// the URL stays the same, since each job has one page
const postingLang = jobLanguage(job);
const lang: Lang = postingLang && (locales as readonly string[]).includes(postingLang) ? (postingLang as Lang) : "en";
// the title and description say their own language when it differs from the page's
const contentLang = postingLang && postingLang !== lang ? postingLang : undefined;
const m = t(lang);
const j = m.job;
const md = m.medicine;
const u = (path: string) => localizePath(path, lang);

const company = await getCompany(job.company);
const companyName = company?.name ?? job.company;
// a job board's job is hired for by its employer and applied to on the board
const employer = job.employer ?? companyName;
const closed = Boolean(job.closedAt);
const medicine = isMedicine(job);
// pages for the job's hospital and its hospital group, when they have one
const hospitalIndex = medicine ? await getHospitalIndex() : undefined;
const hospitalSlug = hospitalIndex && hospitalSlugOf(hospitalIndex, job.employer);
const groupPage = hospitalIndex?.groups.some((g) => g.slug === job.company);
const where = formatLocations(job.locations, job.remote, 2, lang);
const employment = employmentTypeOf(job);
const url = new URL(`/jobs/${job.slug}`, Astro.site);
const specialtyName = job.specialty ? md.specialties[job.specialty] : undefined;
const at = (path: string) => new URL(u(path), Astro.site);
// closed jobs are noindexed, so they drop the posting markup too
const jsonLd = [
  breadcrumbs(
    medicine
      ? [
          { name: m.sections.medicine, url: at("/medicine") },
          ...(job.specialty ? [{ name: specialtyName!, url: at(specialtyUrl(job.specialty)) }] : []),
          { name: job.title, url },
        ]
      : [
          { name: m.nav.companies, url: at("/companies") },
          { name: companyName, url: at(`/companies/${job.company}`) },
          { name: job.title, url },
        ],
  ),
  ...(closed ? [] : [jobPosting(job, { name: employer, website: job.employer ? undefined : company?.website }, url)]),
];

// Medical jobs link to their own section: the newest jobs in the same specialty and state (or country), and its hubs
const place = medicine ? medicinePlace(job) : {};
const area = place.area ? getArea(place.area) : undefined;
const areaLabel = area ? areaName(area, lang) : undefined;
const medCounts = medicine ? await getMedicineCounts() : undefined;
const cityPage = area && place.city && place.city.slug !== area.slug && (medCounts!.cities.get(`${area.slug}/${place.city.slug}`)?.count ?? 0) >= MIN_CITY_JOBS;
const sameSpecialty = medicine && job.specialty ? (await getMedicineJobsWhere({ specialty: job.specialty })).filter((o) => o.id !== job.id).slice(0, 5) : [];
const sameState = medicine && area ? (await getMedicineJobsWhere(areaFilter(area))).filter((o) => o.id !== job.id && !sameSpecialty.includes(o)).slice(0, 5) : [];
const medicineBrowse = [
  ...(job.specialty ? [{ href: specialtyUrl(job.specialty), label: specialtyName! }] : []),
  ...(job.specialty && area ? [{ href: specialtyUrl(job.specialty, area.slug), label: md.specialtyTitleIn(specialtyName!, areaLabel!) }] : []),
  ...(job.specialty && cityPage ? [{ href: specialtyUrl(job.specialty, area!.slug, place.city!.slug), label: md.specialtyTitleIn(specialtyName!, place.city!.name) }] : []),
  ...(cityPage ? [{ href: medicineLocationUrl(area!.slug, place.city!.slug), label: md.placeTitle(place.city!.name) }] : []),
  ...(area ? [{ href: medicineLocationUrl(area.slug), label: md.placeTitle(areaLabel!) }] : []),
  ...(area?.kind === "state" ? [{ href: medicineLocationUrl(GERMANY), label: md.placeTitle(areaName(getArea(GERMANY)!, lang)) }] : []),
  ...(job.level ? [{ href: levelUrl(job.level), label: md.levelTitle(md.levels[job.level]!) }] : []),
];
// the posting's own page on the job board, or the employer's when it came in through a partner
const onBoard = job.applyUrl.includes("arbeitsagentur.de");
const applyLabel = medicine ? (onBoard ? j.applyVia(companyName) : j.applyEmployer) : job.employer ? j.applyOnBoard(companyName) : j.applyOn(companyName);

// Crosslinks: neighbouring jobs, so every job is linked from other job pages, and the hubs this job belongs to
const related = medicine ? { team: [] as Job[], place: [] as Job[] } : await relatedJobs(job);
const companyJobs = (await getCompanyCounts()).get(job.company) ?? 0;
const tags = tagsOf(job);
const [city] = tags.cities;
const [country] = tags.countries;
const countryInfo = country ? getCountry(country) : undefined;
const placeName = city ? getCity(city)?.name : countryInfo ? countryName(countryInfo, lang) : undefined;
const counts = await getTagCounts();
const only = (slugs: Set<string>, all: Map<string, number>) => new Map([...all].filter(([slug]) => slugs.has(slug)));
const browse = [
  ...technologyLinks(only(tags.technologies, counts.technologies)),
  ...cityLinks(only(tags.cities, counts.cities)),
  ...countryLinks(only(tags.countries, counts.countries), undefined, lang),
  ...(job.remote ? [{ href: remoteUrl(), label: m.remote, count: await getRemoteCount() }] : []),
  ...employmentLinks(only(tags.employment, counts.employment), lang),
];

// "At a glance": dated facts in Workog's own words, the one part of the page not copied from the posting
const asOf = (await getLatestRun())?.finishedAt ?? job.lastSeenAt;
const hospital = hospitalSlug ? hospitalIndex!.hospitals.find((h) => h.slug === hospitalSlug) : undefined;
const companyChange = !medicine && !job.employer ? changeOver(await getSnapshots(), (s) => s.companies[job.company], companyJobs) : undefined;
const nearby = medicine
  ? job.specialty && area
    ? { open: medCounts!.specialtyAreas.get(`${job.specialty}/${area.slug}`) ?? 0, where: areaLabel!, medical: true, specialty: specialtyName }
    : area
      ? { open: (area.kind === "state" ? medCounts!.states : medCounts!.countries).get(area.slug) ?? 0, where: areaLabel!, medical: true }
      : undefined
  : city
    ? { open: counts.cities.get(city) ?? 0, where: placeName!, medical: false }
    : country
      ? { open: counts.countries.get(country) ?? 0, where: placeName!, medical: false }
      : undefined;
const summary = closed
  ? []
  : jobSummary(
      {
        employer,
        postedAt: job.postedAt,
        firstSeenAt: job.firstSeenAt,
        asOf,
        technologies: medicine ? [] : [...tags.technologies].map((slug) => getTechnology(slug)?.name).filter((n) => n !== undefined),
        salary: job.salary && formatSalary(job.salary, lang),
        employerJobs: medicine
          ? hospital && { name: employer, open: hospital.count, doctors: true }
          : job.employer
            ? undefined
            : { name: companyName, open: companyJobs, pct: companyChange?.pct, days: companyChange?.days },
        nearby,
      },
      lang,
    );
---

<Base
  title={j.titleAt(job.title, employer)}
  description={j.description(job.title, employer, where, job.remote, job.employer || company?.board ? companyName : undefined)}
  noindex={closed}
  translated={false}
  lang={lang}
  jsonLd={jsonLd}
  section={medicine ? "medicine" : "tech"}
>
  {
    medicine ? (
      <p class="muted">
        <a href={u("/medicine")}>{m.sections.medicine}</a> /{job.specialty && <> <a href={u(specialtyUrl(job.specialty))}>{specialtyName}</a> /</>}
      </p>
    ) : (
      <p class="muted"><a href={u(`/companies/${job.company}`)}>{companyName}</a> /</p>
    )
  }

  {closed && <p class="closed">{j.closed(formatDate(job.closedAt!, lang))}</p>}

  <h1 lang={contentLang}>{job.title}</h1>
  {medicine ? (
  <dl class="facts">
    <dt>{j.facts.hospital}</dt><dd>{hospitalSlug ? <a href={u(hospitalUrl(hospitalSlug))}>{employer}</a> : employer}</dd>
    <dt>{j.facts.location}</dt><dd>{job.locations.join(" · ") || j.facts.notListed}</dd>
    {job.specialty && <><dt>{j.facts.specialty}</dt><dd><a href={u(specialtyUrl(job.specialty))}>{specialtyName}</a></dd></>}
    {job.level && <><dt>{j.facts.level}</dt><dd><a href={u(levelUrl(job.level))}>{md.levels[job.level]}</a></dd></>}
    {job.salary && <><dt>{j.facts.salary}</dt><dd>{formatSalary(job.salary, lang)}</dd></>}
    {job.department && <><dt>{j.facts.occupation}</dt><dd>{job.department}</dd></>}
    {job.postedAt && <><dt>{j.facts.posted}</dt><dd>{formatDate(job.postedAt, lang)}</dd></>}
    <dt>{j.facts.listedOn}</dt><dd>{groupPage ? <a href={u(hospitalUrl(job.company))}>{companyName}</a> : companyName}</dd>
  </dl>
  ) : (
  <dl class="facts">
    {job.employer
      ? <><dt>{j.facts.company}</dt><dd>{job.employer}</dd><dt>{j.facts.listedOn}</dt><dd><a href={u(`/companies/${job.company}`)}>{companyName}</a></dd></>
      : <><dt>{j.facts.company}</dt><dd><a href={u(`/companies/${job.company}`)}>{companyName}</a></dd></>}
    <dt>{j.facts.location}</dt><dd>{job.locations.join(" · ") || j.facts.notListed}{job.remote && <> <a class="tag" href={u("/remote")}>{m.remote}</a></>}</dd>
    <dt>{j.facts.employmentType}</dt><dd><a href={u(`/employment/${employment}`)}>{m.employment.types[employment]}</a></dd>
    {job.salary && <><dt>{j.facts.salary}</dt><dd>{formatSalary(job.salary, lang)}</dd></>}
    {job.department && <><dt>{j.facts.team}</dt><dd>{job.department}</dd></>}
    {job.postedAt && <><dt>{j.facts.posted}</dt><dd>{formatDate(job.postedAt, lang)}</dd></>}
  </dl>
  )}

  {!closed && <p><a class="apply" href={job.applyUrl} rel="nofollow noopener" target="_blank">{applyLabel} →</a></p>}

  {summary.length > 0 && <section class="summary"><h2>{j.glanceTitle}</h2><p>{summary.join(" ")}</p></section>}

  {job.descriptionHtml ? <article class="description" lang={contentLang} set:html={job.descriptionHtml} /> : <p class="muted">{j.noDescription}</p>}

  {!closed && job.descriptionHtml && <p><a class="apply" href={job.applyUrl} rel="nofollow noopener" target="_blank">{applyLabel} →</a></p>}

  {sameSpecialty.length > 0 && <section><h2>{j.moreSpecialty(specialtyName!)}</h2><JobList jobs={sameSpecialty} lang={lang} /></section>}
  {sameState.length > 0 && <section><h2>{j.moreMedicalIn(areaLabel!)}</h2><JobList jobs={sameState} lang={lang} /></section>}
  {medicineBrowse.length > 0 && <section><h2>{j.browseSimilar}</h2><ul class="browse">{medicineBrowse.map((l) => <li><a href={u(l.href)}>{l.label}</a></li>)}</ul></section>}

  {
    related.team.length > 0 && (
      <section>
        <h2>{j.moreAt(job.category ? categoryName(job.category, lang) : undefined, companyName, Boolean(job.employer))}</h2>
        <JobList jobs={related.team} showCompany={false} lang={lang} />
        {companyJobs > related.team.length + 1 && <p><a href={u(`/companies/${job.company}`)}>{j.allAt(companyJobs, companyName, Boolean(job.employer))} →</a></p>}
      </section>
    )
  }
  {
    related.place.length > 0 && (
      <section>
        <h2>{placeName ? j.moreIn(placeName) : j.moreRemote}</h2>
        <JobList jobs={related.place} lang={lang} />
      </section>
    )
  }
  {!medicine && browse.length > 0 && <section><h2>{j.browseSimilar}</h2><TagLinks links={browse} lang={lang} /></section>}
</Base>

<style>
  .facts { display: grid; grid-template-columns: max-content 1fr; gap: 4px 16px; margin: 16px 0 24px; }
  .facts dt { color: var(--muted); }
  .facts dd { margin: 0; }
  .apply { display: inline-block; background: var(--accent); color: var(--accent-text); padding: 10px 18px; border-radius: 6px; font-weight: 600; text-decoration: none; }
  .closed { background: var(--tag); border-left: 4px solid var(--muted); padding: 12px 16px; }
  .summary { max-width: 760px; margin: 24px 0; padding: 12px 16px; background: var(--surface); border: 1px solid var(--border); border-radius: 8px; }
  .summary h2 { font-size: 1rem; margin: 0 0 4px; }
  .summary p { margin: 0; }
  .description { max-width: 760px; margin: 24px 0; overflow-wrap: anywhere; }
  .browse { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 8px 16px; }
  @media (max-width: 640px) {
    .facts { grid-template-columns: 1fr; gap: 0; }
    .facts dt { font-size: 13px; margin-top: 8px; }
    .apply { display: block; text-align: center; padding: 14px 18px; }
  }
  .description :global(table) { display: block; overflow-x: auto; }
</style>
