---
import type { GetStaticPaths } from "astro";
import Base from "../../../layouts/Base.astro";
import JobList from "../../../components/JobList.astro";
import { countTags, getJobsWhere } from "../../../lib/jobs.ts";
import { countries } from "../../../lib/places.ts";
import { remoteUrl } from "../../../lib/links.ts";
import { countryName, getLang, localizePath, t, withLangs } from "../../../lib/i18n.ts";
import { LIST_PAGE_LIMIT } from "../../../lib/constants.ts";

export const getStaticPaths = (async () => {
  const counts = await countTags(await getJobsWhere({ remote: true }));
  return withLangs(
    countries.filter((c) => counts.countries.has(c.slug)).map((country) => ({ params: { country: country.slug }, props: { country } })),
  );
}) satisfies GetStaticPaths;

const { country } = Astro.props;
const lang = getLang(Astro.params.lang);
const m = t(lang);
const name = countryName(country, lang);
const jobs = await getJobsWhere({ remote: true, country: country.slug });
---

<Base title={m.remoteJobs.titleIn(name)} description={m.remoteJobs.countryDescription(jobs.length, name)}>
  <p class="muted"><a href={localizePath(remoteUrl(), lang)}>{m.remoteJobs.title}</a> /</p>
  <h1>{m.remoteJobs.titleIn(name)}</h1>
  <p class="muted">
    {m.openPositions(jobs.length)}
    {jobs.length > LIST_PAGE_LIMIT && m.showingNewest(LIST_PAGE_LIMIT)}
  </p>
  <p><a href={localizePath(`/locations/${country.slug}`, lang)}>{m.place.title(name)} →</a></p>
  <h2>{m.latestJobs}</h2>
  <JobList jobs={jobs.slice(0, LIST_PAGE_LIMIT)} />
</Base>
