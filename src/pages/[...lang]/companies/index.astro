---
import type { GetStaticPaths } from "astro";
import Base from "../../../layouts/Base.astro";
import { getCompanies, getOpenJobs } from "../../../lib/jobs.ts";
import { getLang, localizePath, t, withLangs } from "../../../lib/i18n.ts";

export const getStaticPaths = (() => withLangs([{ params: {} }])) satisfies GetStaticPaths;

const lang = getLang(Astro.params.lang);
const m = t(lang);
const jobs = await getOpenJobs();
const counts = new Map<string, number>();
for (const job of jobs) counts.set(job.company, (counts.get(job.company) ?? 0) + 1);
const companies = (await getCompanies())
  .map((c) => ({ ...c, count: counts.get(c.key) ?? 0 }))
  .sort((a, b) => a.name.localeCompare(b.name));
---

<Base title={m.companies.title} description={m.companies.description(companies.length)}>
  <h1>{m.companies.title}</h1>
  <ul class="companies">
    {
      companies.map((c) => (
        <li>
          <a href={localizePath(`/companies/${c.key}`, lang)}>{c.name}</a>
          <span class="muted">{m.openJobs(c.count)}</span>
        </li>
      ))
    }
  </ul>
</Base>

<style>
  .companies { list-style: none; padding: 0; margin: 0; border-top: 1px solid var(--border); }
  li { display: flex; justify-content: space-between; gap: 16px; padding: 10px 0; border-bottom: 1px solid var(--border); }
</style>
