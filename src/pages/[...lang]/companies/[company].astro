---
import type { GetStaticPaths } from "astro";
import Base from "../../../layouts/Base.astro";
import JobList from "../../../components/JobList.astro";
import TagLinks from "../../../components/TagLinks.astro";
import { countTags, getCompanies, getJobsByCompany } from "../../../lib/jobs.ts";
import { cityLinks, technologyLinks } from "../../../lib/links.ts";
import { categoryName, getLang, localizePath, t, withLangs } from "../../../lib/i18n.ts";
import { LIST_PAGE_LIMIT } from "../../../lib/constants.ts";

export const getStaticPaths = (async () => {
  const companies = await getCompanies();
  return withLangs(companies.map((company) => ({ params: { company: company.key }, props: { company } })));
}) satisfies GetStaticPaths;

const { company } = Astro.props;
const lang = getLang(Astro.params.lang);
const m = t(lang);
const jobs = await getJobsByCompany(company.key);
const counts = await countTags(jobs);
const cities = cityLinks(counts.cities).slice(0, 24);
const techs = technologyLinks(counts.technologies);
const categories = [...new Set(jobs.map((j) => j.category).filter(Boolean))].sort().map((c) => categoryName(c, lang));
---

<Base title={m.company.title(company.name)} description={m.company.description(jobs.length, company.name, categories.slice(0, 4))}>
  <p class="muted"><a href={localizePath("/companies", lang)}>{m.nav.companies}</a> /</p>
  <h1>{m.company.title(company.name)}</h1>
  <p class="muted">
    {m.openPositions(jobs.length)}
    {jobs.length > LIST_PAGE_LIMIT && m.showingNewest(LIST_PAGE_LIMIT)}
  </p>
  {cities.length > 0 && <><h2>{m.place.cities}</h2><TagLinks links={cities} /></>}
  {techs.length > 0 && <><h2>{m.place.technologies}</h2><TagLinks links={techs} /></>}
  {jobs.length > 0 && <h2>{m.latestJobs}</h2>}
  {jobs.length ? <JobList jobs={jobs.slice(0, LIST_PAGE_LIMIT)} showCompany={false} /> : <p>{m.company.none}</p>}
</Base>
