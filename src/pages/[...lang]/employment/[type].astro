---
import type { GetStaticPaths } from "astro";
import Base from "../../../layouts/Base.astro";
import JobList from "../../../components/JobList.astro";
import { getJobsWhere, tagsOf } from "../../../lib/jobs.ts";
import { employmentTypes } from "../../../lib/employment.ts";
import { getLang, localizePath, t, withLangs } from "../../../lib/i18n.ts";
import { LIST_PAGE_LIMIT } from "../../../lib/constants.ts";

export const getStaticPaths = (() =>
  withLangs(employmentTypes.map((type) => ({ params: { type }, props: { type } })))) satisfies GetStaticPaths;

const { type } = Astro.props;
const lang = getLang(Astro.params.lang);
const m = t(lang);
const name = m.employment.types[type];
const jobs = await getJobsWhere({ employment: type });
const countries = new Set(jobs.flatMap((j) => [...tagsOf(j).countries])).size;
const remote = jobs.filter((j) => j.remote).length;
---

<Base title={m.employment.typeTitle(name)} description={m.employment.typeDescription(jobs.length, name, countries)} noindex={!jobs.length}>
  <p class="muted"><a href={localizePath("/employment", lang)}>{m.employment.label}</a> /</p>
  <h1>{m.employment.typeTitle(name)}</h1>
  <p class="muted">
    {m.openPositions(jobs.length)}
    {jobs.length > LIST_PAGE_LIMIT && m.showingNewest(LIST_PAGE_LIMIT)}
    {remote > 0 && <> · {m.remote}: {remote}</>}
  </p>
  <h2>{m.latestJobs}</h2>
  {jobs.length ? <JobList jobs={jobs.slice(0, LIST_PAGE_LIMIT)} /> : <p>{m.employment.none(name)}</p>}
</Base>
