---
/**
 * The start page: one panel per section, each with its size and shortcuts to
 * its biggest browse pages. There is no search, so the shortcuts do that job.
 */
import type { GetStaticPaths } from "astro";
import Base from "../../layouts/Base.astro";
import LineChart from "../../components/LineChart.astro";
import { getCompanies, getHistory, getMedicineSnapshots, getMedicineCounts, getOpenJobs, getOpenMedicineJobs, getRemoteCount, getTagCounts } from "../../lib/jobs.ts";
import { cityLinks, remoteUrl, medicineCountryLinks, specialtyLinks, technologyLinks } from "../../lib/links.ts";
import { getLang, localizePath, t, withLangs } from "../../lib/i18n.ts";
import { formatNumber } from "../../lib/locale.ts";
import { website } from "../../lib/structured-data.ts";
import { reportUrl } from "../../lib/reports.ts";
import { dailyTotals } from "../../lib/analytics.ts";
import { TREND_MIN_DAYS } from "../../lib/constants.ts";

export const getStaticPaths = (() => withLangs([{ params: {} }])) satisfies GetStaticPaths;

const lang = getLang(Astro.params.lang);
const m = t(lang);
const s = m.start;
const u = (path: string) => localizePath(path, lang);

const techJobs = await getOpenJobs();
const companies = (await getCompanies()).length;
const tags = await getTagCounts();
const tech = [
  ...technologyLinks(tags.technologies).slice(0, 3),
  { href: remoteUrl(), label: m.remote, count: await getRemoteCount() },
  ...cityLinks(tags.cities).slice(0, 2),
  { href: "/technologies", label: s.allTechnologies },
  { href: "/locations", label: s.allLocations },
];

const medicalJobs = await getOpenMedicineJobs();
const med = await getMedicineCounts();
const medicine = [
  ...specialtyLinks(med.specialties, lang).slice(0, 4),
  ...medicineCountryLinks(med.countries, lang).slice(0, 2),
  { href: "/medicine/specialties", label: s.allSpecialties },
  { href: "/medicine/locations", label: s.allLocations },
];
const description = s.description(techJobs.length, medicalJobs.length);

// a glance at each section's numbers and its open-jobs line
const a = m.analytics;
const remote = await getRemoteCount();
// skip the first days, while sources were still being added, so the line shows real change
const settled = <T extends { open: number }>(days: T[]) => {
  const peak = Math.max(0, ...days.map((d) => d.open));
  return days.slice(Math.max(0, days.findIndex((d) => d.open >= peak / 2)));
};
const medSnapshots = await getMedicineSnapshots();
const medMonth = medSnapshots.at(-1)?.date.slice(0, 7);
const sections = [
  {
    stats: [
      { label: a.openJobs, value: formatNumber(techJobs.length, lang) },
      { label: a.companiesHiring, value: formatNumber(companies, lang) },
      { label: a.remote, value: `${Math.round((remote / Math.max(1, techJobs.length)) * 100)}%` },
    ],
    days: settled(dailyTotals(await getHistory())).map((d) => ({ date: d.date, value: d.open })),
    href: "/analytics",
    browse: s.analyticsBrowse,
  },
  {
    stats: [
      { label: a.openJobs, value: formatNumber(medicalJobs.length, lang) },
      { label: s.analyticsCountries, value: formatNumber(med.countries.size, lang) },
      { label: s.analyticsSpecialties, value: formatNumber(med.specialties.size, lang) },
    ],
    days: settled(medSnapshots).map((d) => ({ date: d.date, value: d.open })),
    href: medMonth ? reportUrl("medicine", medMonth) : "/medicine",
    browse: medMonth ? s.analyticsMedicineBrowse : s.medicineBrowse,
  },
];
const [techSec, medSec] = sections;
---

<Base title="Workog" description={description} section="start" jsonLd={[website(Astro.site!, description)]}>
  <section class="hero">
    <h1>{s.heroHeading}</h1>
    <div class="live">
      <p class="live-label"><span class="dot" aria-hidden="true"></span>{s.heroLive}</p>
      <p class="live-count">{formatNumber(techJobs.length + medicalJobs.length, lang)}</p>
      <p class="live-split">{s.heroSplit(techJobs.length, medicalJobs.length)}</p>
    </div>
  </section>
  <div class="panels">
    <section class="panel tech">
      <a class="label" href={u("/tech")}>
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 7l-5 5 5 5M16 7l5 5-5 5" /></svg>
        {s.tech}
      </a>
      <h2>{s.techHeading}</h2>
      <dl class="stats">
        {techSec.stats.map((st) => <div><dt>{st.label}</dt><dd>{st.value}</dd></div>)}
      </dl>
      {
        techSec.days.length >= TREND_MIN_DAYS && (
          <div class="trend">
            <p class="chart-title">{a.openOverTime}</p>
            <LineChart points={techSec.days} unit={a.openJobsUnit} height={120} />
          </div>
        )
      }
      <nav aria-label={s.techHeading} class="chips">
        {tech.map((l) => <a href={u(l.href)}>{l.label}{"count" in l && <span>{formatNumber(l.count, lang)}</span>}</a>)}
      </nav>
      <p class="links">
        <a class="browse" href={u("/tech")}>{s.techBrowse}</a>
        <a class="browse secondary" href={u(techSec.href)}>{techSec.browse}</a>
      </p>
    </section>
    <section class="panel medicine">
      <a class="label" href={u("/medicine")}>
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
        {s.medicine}
      </a>
      <h2>{s.medicineHeading}</h2>
      <dl class="stats">
        {medSec.stats.map((st) => <div><dt>{st.label}</dt><dd>{st.value}</dd></div>)}
      </dl>
      {
        medSec.days.length >= TREND_MIN_DAYS && (
          <div class="trend">
            <p class="chart-title">{a.openOverTime}</p>
            <LineChart points={medSec.days} unit={a.openJobsUnit} height={120} />
          </div>
        )
      }
      {
        medicalJobs.length > 0 && (
          <nav aria-label={s.medicineHeading} class="chips">
            {medicine.map((l) => <a href={u(l.href)}>{l.label}{"count" in l && <span>{formatNumber(l.count, lang)}</span>}</a>)}
          </nav>
        )
      }
      <p class="links">
        <a class="browse" href={u("/medicine")}>{s.medicineBrowse}</a>
        <a class="browse secondary" href={u(medSec.href)}>{medSec.browse}</a>
      </p>
    </section>
  </div>
</Base>

<style>
  .hero { padding: 48px max(24px, 5vw) 40px; background: #0b1730; color: #c9d6ee; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 24px 40px; }
  .hero h1 { margin: 0; font-size: clamp(2.2rem, 5vw, 3.4rem); line-height: 1.05; color: #ffffff; max-width: 16ch; text-wrap: balance; }
  .live { border: 1px solid #2c4373; border-radius: 16px; padding: 16px 22px; min-width: 240px; }
  .live-label { margin: 0; font-size: 14px; color: #a9c1f2; }
  .live-count { margin: 4px 0 0; font-size: clamp(2rem, 4vw, 2.75rem); font-weight: 700; line-height: 1.1; color: #ffffff; font-variant-numeric: tabular-nums; }
  .live-split { margin: 4px 0 0; font-size: 14px; color: #a9c1f2; }
  .dot { display: inline-block; vertical-align: 0.05em; margin-right: 10px; width: 10px; height: 10px; border-radius: 50%; background: #4ade80; box-shadow: 0 0 0 4px rgb(74 222 128 / 0.18); }
  .panels { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr)); min-height: calc(100vh - 420px); }
  .panel { display: flex; flex-direction: column; justify-content: flex-start; gap: 18px; padding: 64px max(24px, 5vw); color: #e6edfb; }
  .panel.tech { background: #13233f; }
  .panel.medicine { background: #0f2e2a; color: #e6f2ef; }
  .label { align-self: flex-start; text-decoration: none; display: flex; align-items: center; gap: 10px; margin: 0; font-size: 14px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; }
  .tech .label { color: #a9c1f2; }
  .medicine .label { color: #99d5ca; }
  .label:hover { color: #ffffff; }
  .panel h2 { margin: 0; font-size: clamp(1.6rem, 3.4vw, 2.2rem); line-height: 1.12; color: #ffffff; }
    .chips { display: flex; flex-wrap: wrap; gap: 8px; max-width: 560px; }
  .chips a {
    display: inline-flex; align-items: center; gap: 8px; min-height: 40px; padding: 0 14px; border-radius: 999px;
    color: #ffffff; text-decoration: none; font-size: 14px;
  }
  .tech .chips a { background: #23396a; }
  .medicine .chips a { background: #1b4741; }
  .chips a:hover { filter: brightness(1.15); }
  .tech .chips span { color: #a9c1f2; }
  .medicine .chips span { color: #99d5ca; }
  .browse { color: #ffffff; font-weight: 600; text-decoration: none; }
  .browse:hover { text-decoration: underline; }
  .panel.tech { --accent: #a9c1f2; --border: #2c4373; --muted: #a9c1f2; --bg: #13233f; --tag: #23396a; --card: #1b2f55; }
  .panel.medicine { --accent: #99d5ca; --border: #24524b; --muted: #99d5ca; --bg: #0f2e2a; --tag: #1b4741; --card: #163c37; }
  .stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin: 0; max-width: 560px; }
  .stats div { background: var(--card); border-radius: 12px; padding: 12px 14px; min-width: 0; }
  .stats dt { font-size: 13px; color: var(--muted); }
  .stats dd { margin: 4px 0 0; font-size: 22px; font-weight: 700; color: #ffffff; font-variant-numeric: tabular-nums; }
  .trend { max-width: 560px; }
  .links { display: flex; flex-wrap: wrap; gap: 8px 24px; margin: 0; }
  .browse.secondary { color: var(--accent); }
  .chart-title { margin: 0 0 8px; font-size: 14px; color: var(--muted); }
  @media (max-width: 640px) {
    .panels { min-height: 0; }
    .panel { padding: 32px 20px; gap: 14px; }
    .hero { padding: 32px 20px 28px; }
  }
</style>
