---
import type { GetStaticPaths } from "astro";
import Base from "../../layouts/Base.astro";
import AsOf from "../../components/AsOf.astro";
import BarList from "../../components/BarList.astro";
import ColumnChart from "../../components/ColumnChart.astro";
import LineChart from "../../components/LineChart.astro";
import Movers from "../../components/Movers.astro";
import { countTags, getCompanies, getHistory, getLatestRun, getOpenJobs, getSnapshots } from "../../lib/jobs.ts";
import { cityLinks, countryLinks, snapshotLabels, technologyLinks } from "../../lib/links.ts";
import {
  addDays,
  countBy,
  dailySnapshots,
  dailyTotals,
  medianAgeDays,
  movers,
  postedByMonth,
  remoteShareBy,
  type SnapshotDimension,
  snapshotOn,
  weeklyTotals,
} from "../../lib/analytics.ts";
import { formatDate, formatDateTime, formatShortDate } from "../../lib/format.ts";
import { categoryName, getLang, localizePath, t, withLangs } from "../../lib/i18n.ts";
import { formatNumber, intlLocale } from "../../lib/locale.ts";
import { TREND_MIN_DAYS } from "../../lib/constants.ts";
import { reportUrl } from "../../lib/reports.ts";

const TOP = 10;
const MOVERS = 5;
/** compare today with the snapshot this many days earlier, or the first one if history is shorter */
const MOVERS_WINDOW = 7;
/** functions drawn as small multiples */
const TOP_FUNCTIONS = 6;

export const getStaticPaths = (() => withLangs([{ params: {} }])) satisfies GetStaticPaths;

const lang = getLang(Astro.params.lang);
const m = t(lang);
const a = m.analytics;
const date = (iso: string) => formatDate(iso, lang);

const jobs = await getOpenJobs();
const companies = await getCompanies();
const companyNames = new Map(companies.map((c) => [c.key, c.name]));
const run = await getLatestRun();
const ref = run ? new Date(run.startedAt) : new Date();

const remoteCount = jobs.filter((j) => j.remote).length;
const newInRun = run?.sources.reduce((sum, s) => sum + s.new, 0) ?? 0;
const closedInRun = run?.sources.reduce((sum, s) => sum + s.closed, 0) ?? 0;

const byCategory = countBy(jobs, (j) => categoryName(j.category, lang));
const byCompany = countBy(jobs, (j) => j.company).map((b) => ({
  ...b,
  label: companyNames.get(b.label) ?? b.label,
  href: `/companies/${b.label}`,
}));
const tags = await countTags(jobs);
const toBars = (links: { href: string; label: string; count: number }[]) => links.slice(0, TOP);
const topTechnologies = toBars(technologyLinks(tags.technologies));
const topCountries = toBars(countryLinks(tags.countries, undefined, lang));
const topCities = toBars(cityLinks(tags.cities));
const remoteByCategory = remoteShareBy(jobs, (j) => categoryName(j.category, lang));

const posted = postedByMonth(jobs, ref, 8, intlLocale(lang));
const medianAge = medianAgeDays(jobs, ref);

const days = dailyTotals(await getHistory());
const weeks = weeklyTotals(days).slice(-12);
const showTrends = days.length >= TREND_MIN_DAYS;

const snapshots = await getSnapshots();
const snapshotDays = dailySnapshots(snapshots);
const latest = snapshots.at(-1);
const base = latest && (snapshotOn(snapshots, addDays(latest.date, -MOVERS_WINDOW)) ?? snapshots[0]);
const labels = snapshotLabels(lang, companyNames);
const showMovers = !!latest && !!base && base.date < latest.date;
const moverDims = ["technologies", "countries", "companies", "categories"] as const satisfies SnapshotDimension[];
const moverGroups = (showMovers ? moverDims : []).map((dim) => {
  const { up, down } = movers(base![dim], latest![dim], MOVERS);
  const label = (m: (typeof up)[number]) => ({ ...m, ...labels[dim](m.key) });
  return { dim, up: up.map(label), down: down.map(label) };
});
const moverHeadings: Record<(typeof moverDims)[number], string> = {
  technologies: a.topTechnologies,
  countries: a.topCountries,
  companies: a.byCompany,
  categories: a.byFunction,
};
const showSnapshotTrends = snapshotDays.length >= TREND_MIN_DAYS;
const topFunctions = latest
  ? Object.entries(latest.categories).sort(([, x], [, y]) => y - x).slice(0, TOP_FUNCTIONS).map(([key]) => key)
  : [];
const percent = (v: number) => `${Math.round(v)}%`;

const pct = (n: number) => `${Math.round((n / Math.max(1, jobs.length)) * 100)}%`;
---

<Base title={a.title} description={a.description(jobs.length)}>
  <h1>{a.title}</h1>
  <AsOf title={m.sections.tech} count={jobs.length} series={{ section: "tech" }} />
  {run && <p class="muted">{m.lastUpdated} <time datetime={run.finishedAt}>{formatDateTime(run.finishedAt, lang)}</time></p>}

  <dl class="stats">
    <div><dt>{a.openJobs}</dt><dd>{formatNumber(jobs.length, lang)}</dd></div>
    <div><dt>{a.companiesHiring}</dt><dd>{byCompany.length}</dd></div>
    <div><dt>{a.remote}</dt><dd>{pct(remoteCount)}</dd></div>
    <div><dt>{a.latestRun}</dt><dd>+{newInRun} <span class="muted">/ −{closedInRun}</span></dd></div>
  </dl>

  <section>
    <h2>{a.trends}</h2>
    {
      showTrends ? (
        <div class="grid">
          <div>
            <h3>{a.openOverTime}</h3>
            <LineChart points={days.map((d) => ({ date: d.date, value: d.open }))} unit={a.openJobsUnit} />
          </div>
          <div>
            <h3>{a.newVsClosed}</h3>
            <ColumnChart
              series={[
                { name: a.new, color: "var(--series-new)" },
                { name: a.closed, color: "var(--series-closed)" },
              ]}
              columns={weeks.map((w) => ({
                label: formatShortDate(w.week, lang),
                values: [w.new, w.closed],
                title: a.weekTitle(date(w.week), w.new, w.closed),
              }))}
            />
          </div>
        </div>
      ) : (
        <p class="muted note">
          {a.trendsPending(TREND_MIN_DAYS, days.length, days[0] && date(days[0].date))}
        </p>
      )
    }
    {
      showSnapshotTrends && (
        <>
          <div class="grid">
            <div>
              <h3>{a.remoteShareOverTime}</h3>
              <LineChart
                points={snapshotDays.map((s) => ({ date: s.date, value: (s.remote / Math.max(1, s.open)) * 100 }))}
                unit={a.remoteShareUnit}
                format={percent}
              />
            </div>
          </div>
          <h3>{a.functionsOverTime}</h3>
          <div class="multiples">
            {topFunctions.map((key) => (
              <div>
                <h4>{categoryName(key, lang)}</h4>
                <LineChart
                  height={90}
                  points={snapshotDays.map((s) => ({ date: s.date, value: s.categories[key] ?? 0 }))}
                  unit={a.openJobsUnit}
                />
              </div>
            ))}
          </div>
        </>
      )
    }
    {
      latest && (
        <p class="more">
          <a href={localizePath("/analytics/history", lang)}>{a.historyLink}</a> ·{" "}
          <a href={localizePath(reportUrl("tech", latest.date.slice(0, 7)), lang)}>{m.reports.latest}</a>
        </p>
      )
    }
  </section>

  {
    showMovers && (
      <section>
        <h2>{a.changeSince(date(base!.date))}</h2>
        <div class="grid">
          {moverGroups.map((g) => (
            <div>
              <h3>{moverHeadings[g.dim]}</h3>
              <Movers up={g.up} down={g.down} />
            </div>
          ))}
        </div>
      </section>
    )
  }

  <div class="grid">
    <section>
      <h2>{a.byFunction}</h2>
      <BarList bars={byCategory} />
    </section>
    <section>
      <h2>{a.byCompany}</h2>
      <BarList bars={byCompany.slice(0, TOP)} />
      <p class="more"><a href={localizePath("/companies", lang)}>{m.allCompanies}</a></p>
    </section>
    <section>
      <h2>{a.topTechnologies}</h2>
      <BarList bars={topTechnologies} />
      <p class="more"><a href={localizePath("/technologies", lang)}>{m.allTechnologies}</a></p>
    </section>
    <section>
      <h2>{a.topCountries}</h2>
      <BarList bars={topCountries} />
      <h3>{a.topCities}</h3>
      <BarList bars={topCities} />
      <p class="more"><a href={localizePath("/locations", lang)}>{m.allLocations}</a></p>
    </section>
  </div>

  <section>
    <h2>{a.postedHeading}</h2>
    <p class="muted">
      {medianAge !== undefined && <>{a.medianAge(medianAge)} </>}
      {posted.earlier > 0 && <>{a.postedEarlier(posted.earlier)} </>}
      {posted.undated > 0 && a.undated(posted.undated)}
    </p>
    <ColumnChart
      showValues
      columns={posted.bars.map((b) => ({ label: b.label, values: [b.count], title: a.postedTitle(b.label, b.count) }))}
    />
  </section>

  <section>
    <h2>{a.remoteByFunction}</h2>
    <BarList share bars={remoteByCategory} />
  </section>

</Base>

<style>
  :root {
    --series-new: #2a78d6;
    --series-closed: #eb6834;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --series-new: #3987e5;
      --series-closed: #d95926;
    }
  }
  section { margin-top: 32px; }
  h2 { margin-bottom: 12px; }
  h3 { font-size: 15px; margin: 16px 0 8px; }
  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 380px), 1fr)); gap: 0 32px; }
  .grid > section, .grid > div { min-width: 0; }
  .stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 12px; margin: 24px 0 0; }
  .stats div { background: var(--surface); border: 1px solid var(--border); border-radius: 8px; padding: 12px 16px; }
  .stats dt { font-size: 13px; color: var(--muted); }
  .stats dd { margin: 0; font-size: 26px; font-weight: 700; font-variant-numeric: tabular-nums; }
  .stats dd .muted { font-size: 18px; font-weight: 400; }
  .note { background: var(--surface); border: 1px dashed var(--border); border-radius: 8px; padding: 12px 16px; }
  .more { font-size: 14px; margin: 8px 0 0; }
  .multiples { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 220px), 1fr)); gap: 16px 24px; }
  .multiples h4 { font-size: 13px; font-weight: 600; margin: 0 0 4px; }
</style>
