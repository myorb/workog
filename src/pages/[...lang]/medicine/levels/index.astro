---
import type { GetStaticPaths } from "astro";
import Base from "../../../../layouts/Base.astro";
import TagLinks from "../../../../components/TagLinks.astro";
import { getMedicineCounts } from "../../../../lib/jobs.ts";
import { levelLinks } from "../../../../lib/links.ts";
import { getLang, localizePath, t, withLangs } from "../../../../lib/i18n.ts";

export const getStaticPaths = (() => withLangs([{ params: {} }])) satisfies GetStaticPaths;

const lang = getLang(Astro.params.lang);
const m = t(lang);
const md = m.medicine;
const links = levelLinks((await getMedicineCounts()).levels, lang);
---

<Base title={md.levelsTitle} description={md.levelsDescription} section="medicine" noindex={!links.length}>
  <p class="muted"><a href={localizePath("/medicine", lang)}>{m.sections.medicine}</a> /</p>
  <h1>{md.levelsTitle}</h1>
  {links.length ? <TagLinks links={links} /> : <p>{md.none}</p>}
</Base>
