---
import type { GetStaticPaths } from "astro";
import Base from "../../../../layouts/Base.astro";
import Breadcrumbs from "../../../../components/Breadcrumbs.astro";
import AsOf from "../../../../components/AsOf.astro";
import JobList from "../../../../components/JobList.astro";
import TagLinks from "../../../../components/TagLinks.astro";
import { countMedicine, getMedicineJobsWhere } from "../../../../lib/jobs.ts";
import { levels, levelUrl } from "../../../../lib/medicine.ts";
import { specialtyLinks, medicineCountryLinks, stateLinks } from "../../../../lib/links.ts";
import { getLang, t, withLangs } from "../../../../lib/i18n.ts";
import { LIST_PAGE_LIMIT, isThin } from "../../../../lib/constants.ts";

export const getStaticPaths = (() => withLangs(levels.map((level) => ({ params: { level } })))) satisfies GetStaticPaths;

const { level } = Astro.params;
const lang = getLang(Astro.params.lang);
const m = t(lang);
const md = m.medicine;
const name = md.levels[level] ?? level;
const jobs = await getMedicineJobsWhere({ level });
const counts = countMedicine(jobs);
const bySpecialty = specialtyLinks(counts.specialties, lang, (s) => levelUrl(level, s));
const byCountry = medicineCountryLinks(counts.countries, lang, (c) => levelUrl(level, undefined, c));
const byState = stateLinks(counts.states, lang, (s) => levelUrl(level, undefined, s));
---

<Base title={md.levelTitle(name)} description={md.levelDescription(jobs.length, name)} section="medicine" noindex={isThin(jobs.length)}>
  <Breadcrumbs trail={[{ name: m.sections.medicine, href: "/medicine" }, { name: md.nav.levels, href: "/medicine/levels" }]} current={md.levelTitle(name)} />
  <h1>{md.levelTitle(name)}</h1>
  <AsOf title={md.levelTitle(name)} count={jobs.length} series={{ section: "medicine", dim: "levels", key: level }} limit={LIST_PAGE_LIMIT} />
  {bySpecialty.length > 0 && <><h2>{md.bySpecialty}</h2><TagLinks links={bySpecialty} /></>}
  {byCountry.length > 1 && <><h2>{md.byCountry}</h2><TagLinks links={byCountry} /></>}
  {byState.length > 0 && <><h2>{md.byState}</h2><TagLinks links={byState} /></>}
  <h2>{m.latestJobs}</h2>
  {jobs.length ? <JobList jobs={jobs.slice(0, LIST_PAGE_LIMIT)} /> : <p>{md.none}</p>}
</Base>
