---
import type { GetStaticPaths } from "astro";
import Base from "../../../../../layouts/Base.astro";
import JobList from "../../../../../components/JobList.astro";
import TagLinks from "../../../../../components/TagLinks.astro";
import { countMedicine, getMedicineCounts, getMedicineJobsWhere } from "../../../../../lib/jobs.ts";
import { areaFilter, areaName, getArea } from "../../../../../lib/medicine.ts";
import { levelLinks } from "../../../../../lib/links.ts";
import { getLang, localizePath, t, withLangs } from "../../../../../lib/i18n.ts";
import { LIST_PAGE_LIMIT } from "../../../../../lib/constants.ts";

// Only combinations with jobs: an empty specialty-and-place page would be thin
export const getStaticPaths = (async () => {
  const counts = await getMedicineCounts();
  return withLangs(
    [...counts.specialtyAreas.keys()].map((key) => {
      const [specialty, area] = key.split("/") as [string, string];
      return { params: { specialty, area } };
    }),
  );
}) satisfies GetStaticPaths;

const { specialty, area: areaSlug } = Astro.params as { specialty: string; area: string };
const lang = getLang(Astro.params.lang);
const m = t(lang);
const md = m.medicine;
const name = md.specialties[specialty] ?? specialty;
const area = getArea(areaSlug)!;
const place = areaName(area, lang);
const jobs = await getMedicineJobsWhere({ specialty, ...areaFilter(area) });
const counts = countMedicine(jobs);
const byLevel = levelLinks(counts.levels, lang);
---

<Base title={md.specialtyTitleIn(name, place)} description={md.specialtyDescriptionIn(jobs.length, name, place)} section="medicine">
  <p class="muted">
    <a href={localizePath("/medicine", lang)}>{m.sections.medicine}</a> /
    <a href={localizePath(`/medicine/specialties/${specialty}`, lang)}>{name}</a> /
  </p>
  <h1>{md.specialtyTitleIn(name, place)}</h1>
  <p class="muted">
    {m.openPositions(jobs.length)}
    {jobs.length > LIST_PAGE_LIMIT && m.showingNewest(LIST_PAGE_LIMIT)}
  </p>
  {byLevel.length > 0 && <><h2>{md.byLevel}</h2><TagLinks links={byLevel} /></>}
  <h2>{m.latestJobs}</h2>
  <JobList jobs={jobs.slice(0, LIST_PAGE_LIMIT)} />
</Base>
