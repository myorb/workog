---
import type { GetStaticPaths } from "astro";
import Base from "../../../../layouts/Base.astro";
import TagLinks from "../../../../components/TagLinks.astro";
import { getMedicineCounts } from "../../../../lib/jobs.ts";
import { specialtyLinks } from "../../../../lib/links.ts";
import { getLang, localizePath, t, withLangs } from "../../../../lib/i18n.ts";

export const getStaticPaths = (() => withLangs([{ params: {} }])) satisfies GetStaticPaths;

const lang = getLang(Astro.params.lang);
const m = t(lang);
const md = m.medicine;
const links = specialtyLinks((await getMedicineCounts()).specialties, lang);
---

<Base title={md.specialtiesTitle} description={md.specialtiesDescription(links.length)} section="medicine" noindex={!links.length}>
  <p class="muted"><a href={localizePath("/medicine", lang)}>{m.sections.medicine}</a> /</p>
  <h1>{md.specialtiesTitle}</h1>
  {links.length ? <TagLinks links={links} /> : <p>{md.none}</p>}
</Base>
