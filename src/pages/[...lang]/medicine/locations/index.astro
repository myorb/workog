---
import type { GetStaticPaths } from "astro";
import Base from "../../../../layouts/Base.astro";
import TagLinks from "../../../../components/TagLinks.astro";
import { getMedicineCounts } from "../../../../lib/jobs.ts";
import { medicineCityLinks, stateLinks } from "../../../../lib/links.ts";
import { getLang, localizePath, t, withLangs } from "../../../../lib/i18n.ts";

export const getStaticPaths = (() => withLangs([{ params: {} }])) satisfies GetStaticPaths;

const lang = getLang(Astro.params.lang);
const m = t(lang);
const md = m.medicine;
const counts = await getMedicineCounts();
const byState = stateLinks(counts.states, lang);
const cities = medicineCityLinks(counts.cities);
---

<Base title={md.locationsTitle} description={md.locationsDescription(byState.length)} section="medicine" noindex={!byState.length}>
  <p class="muted"><a href={localizePath("/medicine", lang)}>{m.sections.medicine}</a> /</p>
  <h1>{md.locationsTitle}</h1>
  {byState.length ? <><h2>{md.states}</h2><TagLinks links={byState} /></> : <p>{md.none}</p>}
  {cities.length > 0 && <><h2>{md.cities}</h2><TagLinks links={cities} /></>}
</Base>
