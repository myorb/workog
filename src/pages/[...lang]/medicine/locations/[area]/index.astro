---
import type { GetStaticPaths } from "astro";
import Base from "../../../../../layouts/Base.astro";
import JobList from "../../../../../components/JobList.astro";
import TagLinks from "../../../../../components/TagLinks.astro";
import { countMedicine, getMedicineCounts, getMedicineJobsWhere } from "../../../../../lib/jobs.ts";
import { type Area, areaFilter, areaName, GERMANY, getArea, levelUrl, medicineCountries, medicineLocationUrl, specialtyUrl, states } from "../../../../../lib/medicine.ts";
import { levelLinks, medicineCityLinks, specialtyLinks, stateLinks } from "../../../../../lib/links.ts";
import { getLang, localizePath, t, withLangs } from "../../../../../lib/i18n.ts";
import { LIST_PAGE_LIMIT, isThin } from "../../../../../lib/constants.ts";

// Every German state and every country, Germany included; empty ones aren't indexed
export const getStaticPaths = (() =>
  withLangs([...states, ...medicineCountries].map(({ slug }) => ({ params: { area: slug }, props: { area: getArea(slug)! } })))) satisfies GetStaticPaths;

const { area } = Astro.props as { area: Area };
const lang = getLang(Astro.params.lang);
const m = t(lang);
const md = m.medicine;
const place = areaName(area, lang);
const germany = area.slug === GERMANY;
const jobs = await getMedicineJobsWhere(areaFilter(area));
const counts = countMedicine(jobs);
const bySpecialty = specialtyLinks(counts.specialties, lang, (s) => specialtyUrl(s, area.slug));
// Germany's cities sit below its states
const cities = medicineCityLinks((await getMedicineCounts()).cities, germany ? new Set(states.map((s) => s.slug)) : area.slug).slice(0, germany ? 24 : undefined);
const byState = germany ? stateLinks(counts.states, lang) : [];
const byLevel = levelLinks(counts.levels, lang, (l) => levelUrl(l, undefined, area.slug));
const germanyName = areaName(getArea(GERMANY)!, lang);
---

<Base title={md.placeTitle(place)} description={md.placeDescription(jobs.length, place)} section="medicine" noindex={isThin(jobs.length)}>
  <p class="muted">
    <a href={localizePath("/medicine", lang)}>{m.sections.medicine}</a> /
    <a href={localizePath("/medicine/locations", lang)}>{md.nav.locations}</a> /
    {area.kind === "state" && <><a href={localizePath(medicineLocationUrl(GERMANY), lang)}>{germanyName}</a> /</>}
  </p>
  <h1>{md.placeTitle(place)}</h1>
  <p class="muted">
    {m.openPositions(jobs.length)}
    {jobs.length > LIST_PAGE_LIMIT && m.showingNewest(LIST_PAGE_LIMIT)}
  </p>
  {byState.length > 0 && <><h2>{md.states}</h2><TagLinks links={byState} /></>}
  {cities.length > 0 && <><h2>{germany ? md.topCities : md.cities}</h2><TagLinks links={cities} /></>}
  {bySpecialty.length > 0 && <><h2>{md.bySpecialty}</h2><TagLinks links={bySpecialty} /></>}
  {byLevel.length > 0 && <><h2>{md.byLevel}</h2><TagLinks links={byLevel} /></>}
  <h2>{m.latestJobs}</h2>
  {jobs.length ? <JobList jobs={jobs.slice(0, LIST_PAGE_LIMIT)} /> : <p>{md.none}</p>}
</Base>
