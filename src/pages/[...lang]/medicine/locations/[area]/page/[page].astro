---
/** Page 2 onwards of a country's or German state's open medical jobs; page 1 is /medicine/locations/<area> */
import type { GetStaticPaths } from "astro";
import Base from "../../../../../../layouts/Base.astro";
import Breadcrumbs from "../../../../../../components/Breadcrumbs.astro";
import JobList from "../../../../../../components/JobList.astro";
import Pager from "../../../../../../components/Pager.astro";
import { getMedicineJobsWhere } from "../../../../../../lib/jobs.ts";
import { type Area, areaFilter, areaName, GERMANY, getArea, medicineCountries, medicineLocationUrl, states } from "../../../../../../lib/medicine.ts";
import { extraPages, pageCount, pageSlice } from "../../../../../../lib/pagination.ts";
import { getLang, t, withLangs } from "../../../../../../lib/i18n.ts";

export const getStaticPaths = (async () => {
  const paths = [];
  for (const { slug } of [...states, ...medicineCountries]) {
    const area = getArea(slug)!;
    const jobs = await getMedicineJobsWhere(areaFilter(area));
    for (const page of extraPages(jobs.length)) paths.push({ params: { area: slug, page: String(page) }, props: { area, page } });
  }
  return withLangs(paths);
}) satisfies GetStaticPaths;

const { area, page } = Astro.props as { area: Area; page: number };
const lang = getLang(Astro.params.lang);
const m = t(lang);
const md = m.medicine;
const place = areaName(area, lang);
const jobs = await getMedicineJobsWhere(areaFilter(area));
const base = medicineLocationUrl(area.slug);
const heading = md.placeTitle(place);
const pageLabel = m.pager.page(page, pageCount(jobs.length));
const trail = [
  { name: m.sections.medicine, href: "/medicine" },
  { name: md.nav.locations, href: "/medicine/locations" },
  ...(area.kind === "state" ? [{ name: areaName(getArea(GERMANY)!, lang), href: medicineLocationUrl(GERMANY) }] : []),
  { name: heading, href: base },
];
---

<Base title={m.pager.titled(heading, page)} description={`${md.placeDescription(jobs.length, place)} ${pageLabel}.`} section="medicine">
  <Breadcrumbs trail={trail} current={m.pager.titled(heading, page)} />
  <h1>{heading}</h1>
  <p class="muted">{m.openPositions(jobs.length)} · {pageLabel}</p>
  <JobList jobs={pageSlice(jobs, page)} />
  <Pager base={base} page={page} jobCount={jobs.length} />
</Base>
