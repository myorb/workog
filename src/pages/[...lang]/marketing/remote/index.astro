---
import type { GetStaticPaths } from "astro";
import RoleHub from "../../../../components/RoleHub.astro";
import { remotePage } from "../../../../lib/role-pages.ts";
import { getLang, withLangs } from "../../../../lib/i18n.ts";

export const getStaticPaths = (() => withLangs([{ params: {} }])) satisfies GetStaticPaths;

const props = await remotePage("marketing", getLang(Astro.params.lang));
---

<RoleHub {...props} />
