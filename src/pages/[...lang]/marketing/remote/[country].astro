---
import type { GetStaticPaths } from "astro";
import RoleHub from "../../../../components/RoleHub.astro";
import { remoteCountryPage, countryPaths } from "../../../../lib/role-pages.ts";
import { getLang, withLangs } from "../../../../lib/i18n.ts";

export const getStaticPaths = (async () => withLangs(await countryPaths("marketing", { remote: true }))) satisfies GetStaticPaths;

const props = await remoteCountryPage("marketing", Astro.props.country, getLang(Astro.params.lang));
---

<RoleHub {...props} />
